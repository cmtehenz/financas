DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Isolated Neon branch for Vitest integration and Playwright. Never point this
# at the production branch. Create a branch named `test` or `preview` in Neon.
TEST_DATABASE_URL=
TEST_DATABASE_BRANCH=test

# Optional extra origins, comma-separated. Use the production domain
# if it is not a *.vercel.app host, e.g. https://app.seudominio.com
BETTER_AUTH_TRUSTED_ORIGINS=
